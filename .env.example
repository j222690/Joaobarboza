# Senha de acesso ao painel /paineljbadmin (obrigatória). Com caracteres especiais (ex.: &), use aspas simples.
ADMIN_PASSWORD=troque-esta-senha
# Segredo usado para assinar o cookie de sessão (obrigatório em produção; use 32+ caracteres aleatórios)
ADMIN_SECRET=gere-um-valor-aleatorio-longo

# Upstash Redis (preenchidas automaticamente pela integração do Vercel Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# ou
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (Também aceita nomes com prefixo, ex.: STORAGE_KV_REST_API_URL / STORAGE_KV_REST_API_TOKEN)

# Opcional: protege /api/cron/keepalive (a Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
# CRON_SECRET=
